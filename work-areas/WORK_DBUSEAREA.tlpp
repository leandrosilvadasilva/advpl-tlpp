#include 'totvs.ch'

//-- @see https://tdn.totvs.com/display/tec/DBUseArea
//-- @see https://tdn.totvs.com/display/tec/DBSetIndex
//-- @see https://tdn.totvs.com/display/tec/Comando+USE

Function U_WORK_DBUSEAREA

    //-- Prepara o ambiente
    if select ("sx2") <= 0
        rpcSetEnv('99','01','admin','99','FAT','U_WORK_DBSELECTAREA')
    endif

    lNewArea := .T.
    cDriver  := 'TOPCONN'
    cArquivo := retSqlName("SA1")
    cAlias   := 'SA1'
    lShared  := .T.
    lReadOnly:= .F.

    dbUseArea(lNewArea,cDriver,cArquivo,(cAlias),lShared,lReadOnly)
    //Uso antigo USE
    //USE SA1990 ALIAS SA1 SHARED NEW VIA "TOPCONN"
    
    dbSelectArea("SB1")
    //dbSelectArea("SA1")

    cIndex1   := cArquivo + '1'
    cIndex2   := cArquivo + '2'
    
    dbSetIndex(cIndex1)
    dbSetIndex(cIndex2)

    rpcClearEnv()

return
