User Function usoSelect3()

Local nAreaOrig := 0

if select("SX2") <= 0
    rpcSetEnv("99","01","admin","99","FAT","usoSelect3")
    
endif
nAreaOrig   := Select()
FWAlertInfo("A área ativa: " + str(Select(),3) + "  Seu ALIAS:  " + Alias() )

dbSelectArea("SA1")
dbSelectArea("SB1")



Return 
