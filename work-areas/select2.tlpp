#include 'totvs.ch'



/*/{Protheus.doc} usoSelect2
(long_description)
@type user function
@author user
@since 11/11/2026
@version version
@param param_name, param_type, param_descr
@return return_var, return_type, return_description
@example
(examples)
@see (links_or_references)
/*/
User Function usoSelect2()

Local nAreaOrig     := 0
Local cCodSA1       := ""

if select("SX2") <= 0
    rpcSetEnv("99","01","admin","99","FAT","select2")    
endif

nAreaOrig   := Select()

dbSelectArea("SA1")

dbGoTop()

if .not. (eof())

    cCodSA1 := SA1->A1_NOME
    FWAlertInfo("Primeiro cliente encontrado: " + cCodSA1)
    
endif

dbSelectArea(nAreaOrig)
FWAlertInfo("A área ativa agora é " + str(Select(),3) + " Seu ALIAS É: " + Alias())

rpcClearEnv()

Return 
